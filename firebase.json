{
  "firestore": { "database": "controlregistroseg", "rules": "firestore.rules" },
  "hosting": {
    "site": "controlregistroseg", "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/reportes/Agricola", "destination": "/reportes/Agricola.html" },
      { "source": "/reportes/DISAL",    "destination": "/reportes/DISAL.html" },
      { "source": "/reportes/ELF",      "destination": "/reportes/ELF.html" },
      { "source": "/reportes/Toyota",   "destination": "/reportes/Toyota.html" },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
