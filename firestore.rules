rules_version = '2';
service cloud.firestore {
  match /databases/controlregistroseg/documents {
    match /{document=**} { allow read, write: if false; }
    function isEditor() {
      return request.auth != null && request.auth.token.email_verified == true
        && (request.auth.token.email.matches('.*@laprensagrafica\\.com')
        || request.auth.token.email.matches('.*@elgrafico\\.com'));
    }
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.email == 'wperez@laprensagrafica.com'
        || request.auth.token.email == 'chuete@laprensagrafica.com');
    }
    function isClienteAutorizado(clienteId) {
      return request.auth != null && request.auth.token.clienteId == clienteId;
    }
    match /productos/{productoId} { allow read: if isEditor(); allow write: if isAdmin(); }
    match /clientes/{clienteId} { allow read: if isEditor() || isClienteAutorizado(clienteId); allow write: if isAdmin(); }
    match /registros/{registroId} {
      allow read: if isEditor() || isClienteAutorizado(resource.data.clienteId);
      allow create: if isEditor();
      allow update, delete: if isAdmin() || (isEditor() && request.auth.uid == resource.data.creadoPor);
    }
    match /metricas/{registroId} { allow read: if isEditor() || isClienteAutorizado(resource.data.clienteId); allow write: if false; }
    match /presence/{uid} { allow read: if isAdmin(); allow write: if isEditor() && request.auth.uid == uid; }
    match /actividad/{docId} { allow read: if isAdmin(); allow create: if isEditor(); }
  }
}
